{
  "name": "gpt-blender",
  "version": "1.0.0",
  "private": true,
  "description": "Editable 3D scenes and interactive browser demos created with GPT and Blender.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "http-server web -a 127.0.0.1 -c-1 -d false",
    "publish:pages": "node src/publish_pages.mjs",
    "scene": "node src/run_blender.mjs",
    "saber:scene": "node src/run_blender.mjs --saber",
    "pelican:scene": "node src/run_blender.mjs --pelican",
    "duo:scene": "node src/run_blender.mjs --duo",
    "duo:video": "node src/render_duo.mjs",
    "pelican:video": "node src/render_pelican.mjs",
    "test:duo": "node src/verify_duo.mjs",
    "render": "node src/run_blender.mjs --render",
    "video": "python3 src/compose_video.py",
    "reference": "python3 src/prepare_reference.py",
    "test": "node src/verify.mjs",
    "test:saber": "node src/verify_saber.mjs",
    "test:pelican": "node src/verify_pelican.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "http-server": "14.1.1",
    "sharp": "0.35.4"
  }
}
