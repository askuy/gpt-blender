[Unit]
Description=Niu Lai interactive 3D viewer
After=network.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/opt/niulai/niulai --addr 127.0.0.1:8766
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
